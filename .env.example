# Copy to .env.local (local) and add the same values in Vercel → Project → Settings → Environment Variables.

# Your live domain, no trailing slash (used for Stripe redirects and print-file URLs)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Stripe (dashboard.stripe.com → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# true = Stripe Tax adds US sales tax at checkout (prices shown before tax). Turn on once you're
# registered in a state – until you pass a state's threshold (usually $100k/yr) you don't collect there.
STRIPE_AUTOMATIC_TAX=false
# true = customer must tick "I accept the terms" in Stripe Checkout. Needs your terms URL
# (https://your-domain.com/terms/) set in Stripe → Settings → Public details first.
STRIPE_REQUIRE_TERMS=false

# Printful (printful.com → Settings → API → create a private token with order + product scopes)
PRINTFUL_API_TOKEN=
# Only needed for account-level tokens (Printful → Stores → store ID)
PRINTFUL_STORE_ID=
# false = orders land as drafts in Printful for you to check first. Switch to true once you trust it.
PRINTFUL_AUTO_CONFIRM=false
# Any long random string; protects the shipping-email webhook
PRINTFUL_WEBHOOK_SECRET=

# Any long random string (e.g. `openssl rand -hex 32`); signs print-file URLs
PRINT_FILE_SECRET=

# Emails via resend.com (optional while testing – without it emails are only logged)
RESEND_API_KEY=
EMAIL_FROM="Seasoned <hello@your-domain.com>"
OWNER_EMAIL=you@example.com

# Meta (optional) – on unless a visitor opts out on /privacy-choices/ or sends Global Privacy Control
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
META_GRAPH_VERSION=v24.0

# Behavior analytics (optional, US store only, same opt-out as the Meta Pixel). Add in Vercel, then redeploy.
# Google Analytics 4: analytics.google.com → Admin → Data streams → Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity (free recordings + heatmaps): clarity.microsoft.com → Settings → Overview → Project ID
NEXT_PUBLIC_CLARITY_ID=
