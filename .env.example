# Copy to .env.local (local) and add the same values in Vercel → Project → Settings → Environment Variables.

# Your live domain, no trailing slash (used for Stripe redirects and print-file URLs)
NEXT_PUBLIC_SITE_URL=https://www.deine-domain.de

# Stripe (dashboard.stripe.com → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# true = Stripe Tax calculates VAT per EU country (prices stay VAT-inclusive). Needs Stripe Tax set up.
STRIPE_AUTOMATIC_TAX=false
# true = customer must tick "I accept the terms" in Stripe Checkout. Needs your AGB URL set in
# Stripe → Settings → Public details first.
STRIPE_REQUIRE_TERMS=false

# Printful (printful.com → Settings → API → create a private token with order + product scopes)
PRINTFUL_API_TOKEN=
# Only needed for account-level tokens (Printful → Stores → store ID)
PRINTFUL_STORE_ID=
# false = orders land as drafts in Printful for you to check first. Switch to true once you trust it.
PRINTFUL_AUTO_CONFIRM=false
# Any long random string; protects the shipping-email webhook
PRINTFUL_WEBHOOK_SECRET=

# Any long random string (e.g. `openssl rand -hex 32`); signs print-file URLs
PRINT_FILE_SECRET=

# Emails via resend.com (optional while testing – without it emails are only logged)
RESEND_API_KEY=
EMAIL_FROM="Liebstück <hallo@deine-domain.de>"
OWNER_EMAIL=you@example.com

# Meta (optional) – only active after a visitor accepts marketing cookies
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
META_GRAPH_VERSION=v24.0
